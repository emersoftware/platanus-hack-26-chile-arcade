{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "game-2075",
  "main": "src/index.ts",
  // Matches the workerd shipped with the installed wrangler; move it forward when you upgrade.
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,

  // Copies ../game.js, ../cover.png and the game's font into public/ before every dev and deploy.
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": "src"
  },

  // Static files are served straight from public/. Only /api/* runs the Worker first.
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "game-2075-leaderboard",
      "database_id": "6e32c99a-b403-44e5-ad38-b4d4bbed29f6",
      "migrations_dir": "migrations"
    }
  ],

  // Per-IP limit on score writes. The game writes once per finished flight.
  "ratelimits": [
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "2075",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "routes": [{ "pattern": "2075.emersoftware.cl", "custom_domain": true }],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
